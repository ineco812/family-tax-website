---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('posts');
posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Layout title="가족상속세무연구소">
  <!-- Hero Section (고딕체 바탕) -->
  <section class="bg-slate-900 text-slate-100 py-24 px-6 font-sans border-b-4 border-slate-800">
    <div class="max-w-5xl mx-auto text-center">
      <h1 class="text-4xl md:text-5xl font-bold mb-6 tracking-tight leading-snug">
        당신의 소중한 자산,<br/>가장 안전하고 지혜롭게 지켜드립니다
      </h1>
      <p class="text-lg md:text-xl text-slate-300 max-w-2xl mx-auto leading-relaxed">
        복잡하고 어려운 상속세와 증여세, 전문가의 명확한 진단과 체계적인 절세 솔루션을 통해 가족의 안정적인 미래를 준비하세요.
      </p>
    </div>
  </section>

  <!-- Posts Section -->
  <section class="max-w-5xl mx-auto px-6 py-20 font-sans">
    <h2 class="text-2xl font-bold mb-10 text-center border-b border-slate-200 pb-4 text-slate-900">최신 상속·세무 칼럼</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {posts.map((post) => (
        <a href={`/posts/${post.id}`} class="block group h-full">
          <article class="bg-white rounded-lg shadow-sm border border-slate-200 p-6 h-full flex flex-col transition-transform transform hover:-translate-y-1 hover:shadow-md">
            
            <!-- 태그 영역 -->
            {post.data.tags && post.data.tags.length > 0 && (
              <div class="flex flex-wrap gap-2 mb-4">
                {post.data.tags.map(tag => (
                  <span class="inline-block bg-slate-100 text-slate-600 text-xs px-2.5 py-1 rounded-full font-medium">
                    #{tag}
                  </span>
                ))}
              </div>
            )}
            
            <h3 class="text-xl font-bold mb-3 text-slate-800 group-hover:text-blue-600 transition-colors line-clamp-2">
              {post.data.title}
            </h3>
            
            <p class="text-slate-600 mb-6 line-clamp-3 text-sm leading-relaxed flex-grow">
              {post.data.summary}
            </p>
            
            <div class="mt-auto pt-4 border-t border-slate-100 flex items-center justify-between">
              <span class="text-xs text-slate-500 font-medium">가족상속세무연구소</span>
              <time datetime={post.data.date.toISOString()} class="text-xs text-slate-400 font-medium">
                {post.data.date.toLocaleDateString('ko-KR', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric'
                })}
              </time>
            </div>
          </article>
        </a>
      ))}
    </div>
  </section>
</Layout>
